APP_ENV=development
API_PREFIX=/api

# Choose one provider: openai or bedrock
LLM_PROVIDER=openai

# OpenAI chat and embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Amazon Bedrock chat and Titan embeddings
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

LLM_TIMEOUT_SECONDS=45
RETRIEVAL_MIN_SCORE=0.20

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aws_academy_copilot
CANVAS_BASE_URL=https://awsacademy.instructure.com
CANVAS_COURSE_ID=183194
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:8000/api/integrations/canvas/callback
